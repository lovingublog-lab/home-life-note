---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {getCollection} from 'astro:content';
const now=new Date();
const posts=(await getCollection('blog',({data})=>!data.draft&&data.pubDate<=now)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="청소·수납·가전 관리 실용 가이드" description="청소, 수납, 가전 관리, 집안 유지관리와 생활비 절약을 실제 생활에서 바로 적용할 수 있게 정리하는 살림 실용 정보 블로그입니다.">
  <section class="hero hero-compact"><div class="container">
    <h1>집안일은 덜 힘들게, 생활은 더 알뜰하게.</h1>
    <p>청소, 수납, 가전 관리와 생활비 절약을 바로 따라 할 수 있는 방법 중심으로 정리합니다.</p>
  </div></section>
  <section class="section section-latest"><div class="container">
    <div class="section-head"><div><div class="eyebrow">Latest</div><h2>최근 글</h2></div></div>
    <div class="grid">{posts.slice(0,6).map(p=><ArticleCard post={p}/>)}</div>
  </div></section>
</BaseLayout>
